
import random
from kivy.app import App
from kivy.uix.boxlayout import BoxLayout
from kivy.uix.label import Label
from kivy.uix.button import Button
from kivy.uix.textinput import TextInput
from kivy.core.window import Window

Window.clearcolor = (0.035, 0.035, 0.09, 1)

class NeonGuess(App):

    def build(self):
        self.wins = 0
        self.losses = 0
        self.number = 0
        self.attempts = 0
        self.active = False

        layout = BoxLayout(
            orientation="vertical",
            padding=20,
            spacing=12
        )

        title = Label(
            text="NEON GUESS\nMOBILE EDITION",
            font_size=30,
            color=(0, 1, 1, 1)
        )
        layout.add_widget(title)

        self.info = Label(
            text="ВЫБЕРИ СЛОЖНОСТЬ",
            font_size=20
        )
        layout.add_widget(self.info)

        self.entry = TextInput(
            hint_text="Введи число",
            multiline=False,
            input_filter="int",
            halign="center",
            font_size=25,
            size_hint_y=None,
            height=60
        )
        layout.add_widget(self.entry)

        self.result = Label(
            text="ГОТОВ К ИГРЕ?",
            font_size=18,
            color=(0, 1, 0.6, 1)
        )
        layout.add_widget(self.result)

        self.stats = Label(
            text="Победы: 0 | Поражения: 0",
            font_size=16
        )
        layout.add_widget(self.stats)

        levels = [
            ("ЛЕГКИЙ", 10, 5),
            ("СРЕДНИЙ", 50, 7),
            ("СЛОЖНЫЙ", 100, 10),
            ("БОСС", 1000, 15)
        ]

        for name, maximum, tries in levels:
            button = Button(
                text=name,
                font_size=18,
                background_color=(0.35, 0.1, 0.7, 1)
            )
            button.bind(
                on_press=lambda instance, m=maximum, t=tries:
                self.start_game(m, t)
            )
            layout.add_widget(button)

        check_button = Button(
            text="ПРОВЕРИТЬ",
            font_size=20,
            background_color=(0, 0.65, 0.8, 1)
        )
        check_button.bind(on_press=self.check)
        layout.add_widget(check_button)

        return layout

    def start_game(self, maximum, tries):
        self.number = random.randint(1, maximum)
        self.attempts = tries
        self.active = True
        self.entry.text = ""

        self.info.text = f"ЧИСЛО ОТ 1 ДО {maximum}"
        self.result.text = f"ПОПЫТОК: {tries}"

    def check(self, instance):
        if not self.active:
            self.result.text = "СНАЧАЛА НАЧНИ ИГРУ!"
            return

        try:
            guess = int(self.entry.text)
        except ValueError:
            self.result.text = "ВВЕДИ ЧИСЛО!"
            return

        if guess == self.number:
            self.wins += 1
            self.active = False
            self.result.text = "ТЫ ПОБЕДИЛ!"
        else:
            self.attempts -= 1

            if self.attempts == 0:
                self.losses += 1
                self.active = False
                self.result.text = (
                    f"ПРОИГРЫШ! ЧИСЛО: {self.number}"
                )
            elif guess < self.number:
                self.result.text = "ЧИСЛО БОЛЬШЕ!"
            else:
                self.result.text = "ЧИСЛО МЕНЬШЕ!"

        self.stats.text = (
            f"Победы: {self.wins} | "
            f"Поражения: {self.losses}"
        )

        self.entry.text = ""


NeonGuess().run()
