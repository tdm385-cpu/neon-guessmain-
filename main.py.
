
from ursina import *
from ursina.prefabs.first_person_controller import FirstPersonController

app = Ursina()

window.title = "TDM SHOOTER 3D"
window.borderless = False
window.fullscreen = False

Sky()

ground = Entity(
    model='plane',
    scale=(100, 1, 100),
    texture='white_cube',
    texture_scale=(50, 50),
    collider='box',
    color=color.rgb(65, 125, 65)
)

player = FirstPersonController()
player.position = (0, 2, 0)
player.speed = 6
player.gravity = 0.5

# Стены арены
for x in range(-20, 21, 10):
    Entity(
        model='cube',
        position=(x, 2, 20),
        scale=(5, 4, 1),
        color=color.gray,
        collider='box'
    )

for z in range(-20, 21, 10):
    Entity(
        model='cube',
        position=(20, 2, z),
        scale=(1, 4, 5),
        color=color.gray,
        collider='box'
    )

# Оружие
gun = Entity(
    parent=camera,
    model='cube',
    position=(0.6, -0.5, 1),
    scale=(0.2, 0.2, 0.8),
    color=color.dark_gray
)

score = 0
score_text = Text(
    text="TDM SHOOTER 3D | SCORE: 0",
    position=(-0.85, 0.45),
    scale=1.5
)

def input(key):
    global score

    if key == 'left mouse down':
        score += 1
        score_text.text = f"TDM SHOOTER 3D | SCORE: {score}"

app.run()

